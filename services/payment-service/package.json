{
  "name": "payment-service",
  "version": "1.0.0",
  "private": true,
  "description": "Service B — PaymentProcessorService (consumes RabbitMQ, persists to Postgres)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "migrate": "ts-node-dev --transpile-only src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-smithy/server-common": "1.0.0-alpha.10",
    "@smithy/smithy-client": "^3.3.0",
    "@smithy/types": "^3.4.0",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.5",
    "ts-node-dev": "^2.0.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
