{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@example/payment-processor-server": [
        "../../build/smithy/typescript-payment-processor-server/typescript-server-codegen/src"
      ],
      "@example/payment-processor-server/*": [
        "../../build/smithy/typescript-payment-processor-server/typescript-server-codegen/src/*"
      ],
      "@example/payment-contracts": [
        "../../build/smithy/typescript-payment-contracts-client/typescript-client-codegen/src"
      ],
      "@example/payment-contracts/*": [
        "../../build/smithy/typescript-payment-contracts-client/typescript-client-codegen/src/*"
      ],
      "@aws-smithy/*": ["node_modules/@aws-smithy/*"],
      "@smithy/*": ["node_modules/@smithy/*"],
      "@aws-sdk/*": ["node_modules/@aws-sdk/*"],
      "@aws-crypto/*": ["node_modules/@aws-crypto/*"],
      "tslib": ["node_modules/tslib"]
    }
  },
  "include": ["src/**/*"]
}
